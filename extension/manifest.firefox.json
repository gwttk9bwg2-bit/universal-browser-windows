{
  "manifest_version": 2,
  "name": "Universal Browser Bridge",
  "version": "1.0.0",
  "description": "Connect an existing Firefox session to Universal Browser.",
  "permissions": ["nativeMessaging", "tabs", "activeTab", "webNavigation", "webRequest", "downloads", "<all_urls>"],
  "background": { "scripts": ["background-firefox.js"] },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true }],
  "browser_action": { "default_title": "Universal Browser" },
  "applications": { "gecko": { "id": "universal-browser@local" } }
}
